# Copy this file to ".env" and fill in your values.
#
# ---- Option A: Groq (recommended — free, fast, no credit card) -------------
# 1. Sign up at https://console.groq.com  ->  create an API key
OPENAI_API_KEY=gsk_your_groq_key_here
OPENAI_BASE_URL=https://api.groq.com/openai/v1
LLM_MODEL=llama-3.1-8b-instant
#
# ---- Option B: OpenAI -------------------------------------------------------
# OPENAI_API_KEY=sk-your_openai_key_here
# OPENAI_BASE_URL=https://api.openai.com/v1
# LLM_MODEL=gpt-4o-mini
#
# ---- Option C: Ollama (fully local, offline, no key) -----------------------
# Install from https://ollama.com, then run:  ollama pull llama3.1
# OPENAI_API_KEY=ollama
# OPENAI_BASE_URL=http://localhost:11434/v1
# LLM_MODEL=llama3.1
